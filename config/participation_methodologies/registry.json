      "label": "MSCI Islamic Index Series",
      "version": "2025-05",
      "active": true,
      "archived": false,
      "effective_date": "2025-05-01",
      "implementation_review": "May 2025 Index Review",
      "asset_scope": ["equity"],
      "source_reference": "MSCI Islamic Index Series Methodology (December 2025)",
      "source_documents": [
        {
          "title": "MSCI Islamic Index Series Methodology",
          "url": "https://www.msci.com/indexes/documents/methodology/2_MSCI_Islamic_Index_Series_Methodology_20251211.pdf",
          "published": "2025-12"
        },
        {
          "title": "Consultation on Methodology Enhancement to the MSCI Islamic Index Series and the MSCI Islamic Index M-Series",
          "url": "https://www.msci.com/downloads/documents/indexes/consultations/equity/77724957-a3a4-ec5b-e8e9-c7e2a5b3bc09.pdf",
          "published": "2024"
        }
      ],
      "denominator_policy": "total_assets",
      "default_screening_context": "NEW_ENTRY",
      "notes": "Active MSCI Islamic Index Series rules. NABI applies NEW_ENTRY thresholds for ordinary research; existing-constituent exit buffers require authoritative membership history.",
      "financial_screen_complete_methodology": true,
      "rules": [
        {
          "rule_id": "msci.total_debt_to_total_assets",
          "screen": "leverage",
          "numerator": "total_debt",
          "denominator": "total_assets",
          "entry_buffer_pct": 30.0,
          "financial_ratio_threshold_pct": 33.33,
          "exit_buffer_pct": 35.0,
          "threshold_pct": 30.0,
          "comparator": "<=",
          "measurement_period": "latest_public_financial_report",
          "screening_context_thresholds": {
            "NEW_ENTRY": 30.0,
            "EXISTING_CONSTITUENT": 33.33,
            "UNKNOWN_MEMBERSHIP": 30.0
          }
        },
        {
          "rule_id": "msci.cash_and_interest_bearing_to_total_assets",
          "screen": "cash_interest",
          "numerator": "cash_and_interest_bearing_securities",
          "denominator": "total_assets",
          "entry_buffer_pct": 30.0,
          "financial_ratio_threshold_pct": 33.33,
          "exit_buffer_pct": 35.0,
          "threshold_pct": 30.0,
          "comparator": "<=",
          "measurement_period": "latest_public_financial_report",
          "screening_context_thresholds": {
            "NEW_ENTRY": 30.0,
            "EXISTING_CONSTITUENT": 33.33,
            "UNKNOWN_MEMBERSHIP": 30.0
          }
        },
        {
          "rule_id": "msci.receivables_and_cash_to_total_assets",
          "screen": "receivables",
          "numerator": "accounts_receivable_plus_cash",
          "denominator": "total_assets",
          "entry_buffer_pct": 46.0,
          "financial_ratio_threshold_pct": 70.0,
          "exit_buffer_pct": null,
          "threshold_pct": 46.0,
          "comparator": "<=",
          "measurement_period": "latest_public_financial_report",
          "screening_context_thresholds": {
            "NEW_ENTRY": 46.0,
            "EXISTING_CONSTITUENT": 70.0,
            "UNKNOWN_MEMBERSHIP": 46.0
          },
          "notes": "May 2025: Entry Buffer 46%, Financial Ratio Threshold 70%, no Exit Buffer."
        },
        {
          "rule_id": "msci.non_permissible_revenue",
          "screen": "business_activity",
          "numerator": "non_permissible_revenue",
          "denominator": "total_revenue",
          "threshold_pct": 5.0,
          "comparator": "<",
          "measurement_period": "latest_reporting_period",
          "notes": "Business activity screen; requires explicit prohibited revenue evidence per MSCI Solutions BISR."
        }
      ]
    },
